# Required for real discovery runs. Unit tests inject a deterministic test provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_PLANNER_MODEL=
# Defaults to OPENAI_PLANNER_MODEL when unset.
OPENAI_CRITIC_MODEL=
OPENAI_SUMMARY_MODEL=
# Responses API storage is disabled by default.
CVER_LLM_STORE=false
CVER_LLM_TIMEOUT_SECONDS=120

CVER_DISCOVERY_DB=data/discovery_runtime.db
CVER_TRUSTED_KB_DB=data/trusted_knowledge.db
CVER_DISCOVERY_ARTIFACTS=data/discovery_artifacts
CVER_DISCOVERY_WORKSPACES=data/discovery_workspaces
CVER_EMERGENCY_STOP_FILE=data/CVER_EMERGENCY_STOP
# Set to true for an environment-level stop; the marker file is checked dynamically.
CVER_EMERGENCY_STOP=false

# FastAPI authentication. Keep enabled outside tests.
CVER_API_AUTH_REQUIRED=true
CVER_API_TOKEN=
CVER_TEST_MODE=false

CVER_DOCKER_IMAGE=alpine:3.20
CVER_KATA_IMAGE=docker.io/library/alpine:3.20
CVER_KATA_RUNTIME=io.containerd.kata.v2
CVER_FIRECRACKER_KERNEL=
CVER_FIRECRACKER_ROOTFS=

# These two switches must both be true before the policy will even consider a
# historical PoC. The v1 package intentionally ships no escape executor.
CVER_DISPOSABLE_LAB_READY=false
CVER_ALLOW_HISTORICAL_POC=false

# Optional version pins and publisher SHA-256 overrides for component installers.
CVER_FIRECRACKER_VERSION=latest
CVER_FIRECRACKER_SHA256=
CVER_KATA_VERSION=latest
CVER_KATA_SHA256=
# Asset resolution order is existing env paths, verified manifest download, then source build.
CVER_FIRECRACKER_ASSET_MODE=auto

# M1 platform/data configuration
OPENAI_REMEDIATION_MODEL=
CVER_CANDIDATES_DIR=data/candidates
CVER_ZERO_DAY_VAULT_DIR=data/zero_day_vault
CVER_TAXONOMY_PATH=taxonomy/root_causes.yaml
CVER_SECURITY_PROPERTIES_PATH=taxonomy/security_properties.yaml
CVER_COMPONENT_REGISTRY_PATH=data/components/fullstack_components.yaml
CVER_DATA_SOURCE_REGISTRY_PATH=data/sources/fullstack_sources.yaml
CVER_DEFAULT_BUDGET_PROFILE=balanced
CVER_LOCAL_EMBEDDING_BACKEND=local-hashing-v1
# local development: linux-keyring; tests/disposable lab: ephemeral; automation only by explicit opt-in: environment
CVER_ZERO_DAY_KEY_MODE=linux-keyring
# Required only when CVER_ZERO_DAY_KEY_MODE=environment. URL-safe base64 encoding of exactly 32 bytes.
CVER_ZERO_DAY_MASTER_KEY=
# Rust-Shyper remains an M3 adapter.
CVER_RUST_SHYPER_ROOT=
