{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cver.local/schemas/discovery/candidate.schema.json",
  "title": "CVER Candidate Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_type", "component_id", "title", "data_class", "content_sha256", "split_group_id", "artifacts", "admission"],
  "properties": {
    "source_type": {"type": "string", "minLength": 1},
    "component_id": {"type": "string", "minLength": 1},
    "external_id": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "data_class": {"enum": ["public", "internal", "confidential", "restricted"]},
    "source_url": {"type": ["string", "null"]},
    "discovered_at": {"type": ["string", "null"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_group_id": {"type": "string", "pattern": "^grp-[0-9a-f]{24}$"},
    "source_metadata": {"type": "object"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "root_cause", "generated_by_model", "requires_human_annotation"],
      "properties": {
        "status": {"const": "candidate"},
        "root_cause": {"type": "null"},
        "generated_by_model": {"const": false},
        "requires_human_annotation": {"const": true}
      }
    }
  }
}
