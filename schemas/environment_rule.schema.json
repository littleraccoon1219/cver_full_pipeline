{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cver.local/schemas/environment_rule.schema.json",
  "title": "CVER Environment Rule IR",
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "operator"],
      "properties": {
        "fact": {"type": "string", "minLength": 1},
        "operator": {
          "enum": ["equals", "not_equals", "exists", "contains", "version_in_range", "has_capability", "kernel_config_enabled", "runtime_equals", "path_mounted", "socket_exposed"]
        },
        "value": {}
      }
    },
    "expression": {
      "oneOf": [
        {"$ref": "#/$defs/condition"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["logic", "conditions"],
          "properties": {
            "logic": {"enum": ["and", "or"]},
            "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["logic", "condition"],
          "properties": {
            "logic": {"const": "not"},
            "condition": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "record_id", "version", "expression"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description_zh": {"type": "string"},
    "description_en": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "expression": {"$ref": "#/$defs/expression"}
  }
}
