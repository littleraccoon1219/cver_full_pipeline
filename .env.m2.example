# CVER M2 Kata discovery
CVER_M2_STATE_DIR=data/m2
CVER_M2_SOURCE_ROOT=${HOME}/security-src
CVER_M2_CONTAINERD_NAMESPACE=cver-m2
CVER_M2_BUDGET=balanced
CVER_M2_ALLOW_SOURCE_FETCH=false
CVER_M2_ALLOW_EXTERNAL_CANDIDATES=false
CVER_M2_DISPOSABLE_LAB_READY=false
CVER_M2_KATA_SMOKE_IMAGE=docker.io/cver/kata-smoke:arm64
CVER_M2_KATA_CONFIG=/opt/kata/share/defaults/kata-containers/configuration-qemu.toml
CVER_M2_SUDO_HELPER=/usr/local/libexec/cver-m2-helper

# Real kata-agent handler fuzzing. These stay false until the relevant approval gate.
CVER_M2_RUST_NIGHTLY=nightly-2026-06-01
CVER_M2_CURRENT_KATA_VERSION=3.32.0
CVER_M2_REAL_FUZZ_ROOT=data/m2/real-fuzz
CVER_M2_ADAPTER_MANIFEST_DIR=configs/m2_adapters
CVER_M2_RUNTIME_ASSETS_ROOT=data/m2/runtime-assets
CVER_M2_ALLOW_ADAPTER_PATCH=false
CVER_M2_ALLOW_RUNTIME_BUILD=false
CVER_M2_ALLOW_GUEST_REPLAY=false
CVER_M2_MAX_VERSIONS=3
CVER_M2_MAX_DISK_GB=20
CVER_M2_COVERAGE_PLATEAU_MINUTES=30

# DeepSeek OpenAI-compatible API. Without a key, deterministic phases continue.
DEEPSEEK_API_KEY=
CVER_LLM_BASE_URL=https://api.deepseek.com
CVER_LLM_MODEL=deepseek-v4-pro
CVER_LLM_TIMEOUT_SECONDS=180
CVER_LLM_MAX_TOKENS=4096
CVER_M2_LLM_ENABLED=true

# Required when binding the M2 API beyond loopback.
CVER_M2_API_TOKEN=

# Reuse M1 encrypted zero-day vault configuration.
CVER_ZERO_DAY_KEY_MODE=linux-keyring
